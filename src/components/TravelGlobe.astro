---
import type { Country, CurrentCity } from "../content/site";

interface Props {
  countries: readonly Country[];
  current: readonly CurrentCity[];
}

const { countries, current } = Astro.props;

const flagSources = import.meta.glob<string>("/node_modules/circle-flags/flags/*.svg", {
  query: "?raw",
  import: "default",
});

const flagFor = async (code: string) => {
  const load = flagSources[`/node_modules/circle-flags/flags/${code}.svg`];
  const svg = load ? await load() : "";
  return `data:image/svg+xml,${encodeURIComponent(svg)}`;
};

const flags = await Promise.all(
  [...countries]
    .sort((a, b) => a.name.localeCompare(b.name))
    .map(async (country) => ({ ...country, src: await flagFor(country.code) })),
);

const nowCities = await Promise.all(
  current.map(async (place) => ({ ...place, src: await flagFor(place.code) })),
);

const currentCodes = new Set(current.map((place) => place.code));

const markers = [
  ...countries
    .filter((country) => !currentCodes.has(country.code))
    .map((country) => ({ location: country.coords, current: false })),
  ...current.map((place) => ({ location: place.coords, current: true })),
];

const tilts = [-6, 4.5, -3, 7, -5, 3];
const photos = countries
  .filter((country) => country.photo)
  .map((country, index) => ({
    code: country.code,
    full: country.photo ?? "",
    thumb: (country.photo ?? "").replace("/travel/", "/travel/thumb/"),
    caption: country.caption ?? country.name,
    coords: country.coords,
    tilt: tilts[index % tilts.length],
  }));

const home = current[0]?.coords ?? [0, 0];
const countryLabel = countries.length === 1 ? "country" : "countries";
---

<div class="travel">
  <div class="travel-stage">
    <canvas
      class="globe-canvas"
      data-markers={JSON.stringify(markers)}
      data-home={JSON.stringify(home)}
      aria-label={`Globe marking ${countries.length} ${countryLabel} visited`}
      role="img"
    ></canvas>
    <div class="polaroids">
      {
        photos.map((photo) => (
          <button
            type="button"
            class="polaroid"
            data-code={photo.code}
            data-coords={JSON.stringify(photo.coords)}
            data-full={photo.full}
            data-caption={photo.caption}
            style={`--tilt: ${photo.tilt}deg`}
            aria-label={`See the photo of ${photo.caption}`}
          >
            <span class="polaroid-card">
              <img src={photo.thumb} alt="" width="56" height="56" loading="lazy" decoding="async" />
              <span class="polaroid-caption">{photo.caption}</span>
            </span>
          </button>
        ))
      }
    </div>
  </div>

  <div class="travel-info">
    <div class="travel-now-block">
      <p class="travel-now-label">
        <span class="online-dot" aria-hidden="true"></span>
        Now in
      </p>
      <p class="travel-now">
        {
          nowCities.map((place) => (
            <span class="travel-city">
              <img src={place.src} alt="" width="18" height="18" />
              {place.city}
            </span>
          ))
        }
      </p>
    </div>
    <p class="travel-count">
      <strong>{countries.length}</strong>{` ${countryLabel} visited`}
    </p>
  </div>

  <ul class="travel-flags" aria-label="Countries visited">
    {
      flags.map((flag) => (
        <li>
          <button
            type="button"
            class="travel-flag"
            data-coords={JSON.stringify(flag.coords)}
            data-code={flag.code}
            title={flag.name}
            aria-label={`Show ${flag.name} on the globe`}
          >
            <img src={flag.src} alt="" width="22" height="22" loading="lazy" />
          </button>
        </li>
      ))
    }
  </ul>

  <dialog class="photo-viewer" aria-label="Travel photo">
    <figure class="photo-print">
      <div class="photo-frame">
        <img class="photo-preview" alt="" width="640" height="800" />
        <img class="photo-full" alt="" width="640" height="800" decoding="async" />
      </div>
      <figcaption></figcaption>
    </figure>
    <button type="button" class="photo-close" aria-label="Close photo">×</button>
  </dialog>
</div>

<script>
  import createGlobe from "cobe";

  type LatLng = [number, number];
  type MarkerData = { location: LatLng; current: boolean };
  type Rgb = [number, number, number];
  type View = { phi: number; theta: number };

  const RADIUS = 0.8;
  const ELEVATION = 0.01;
  const PIN_ROTATE_INTERVAL = 4500;
  const PIN_REST = 9000;
  const PIN_FLOOR = 0.78;
  const SWAY_SPEED = 0.0011;

  const canvas = document.querySelector<HTMLCanvasElement>(".globe-canvas");
  const stage = document.querySelector<HTMLElement>(".travel-stage");

  const toRgb = (value: string, fallback: Rgb): Rgb => {
    const parts = value.split(",").map((part) => Number.parseFloat(part));
    return parts.length === 3 && parts.every(Number.isFinite) ? (parts as Rgb) : fallback;
  };

  const readPalette = () => {
    const styles = getComputedStyle(document.documentElement);
    const read = (name: string, fallback: Rgb) => toRgb(styles.getPropertyValue(name), fallback);
    const isDark = document.documentElement.dataset.theme === "dark";
    return {
      dark: isDark ? 1 : 0,
      mapBrightness: isDark ? 5 : 8,
      baseColor: read("--globe-base", [1, 1, 1]),
      glowColor: read("--globe-glow", [0.95, 0.96, 0.97]),
      markerColor: read("--globe-marker", [0.12, 0.23, 0.37]),
      currentColor: read("--globe-current", [0.13, 0.63, 0.42]),
    };
  };

  const viewFor = ([lat, lng]: LatLng): View => ({
    phi: Math.PI - ((lng * Math.PI) / 180 - Math.PI / 2),
    theta: Math.max(-0.6, Math.min(0.8, ((lat * Math.PI) / 180) * 0.85)),
  });

  const toVector = ([lat, lng]: LatLng) => {
    const latRad = (lat * Math.PI) / 180;
    const lngRad = (lng * Math.PI) / 180 - Math.PI;
    return [
      -Math.cos(latRad) * Math.cos(lngRad),
      Math.sin(latRad),
      Math.cos(latRad) * Math.sin(lngRad),
    ] as const;
  };

  const project = (vector: readonly [number, number, number], view: View) => {
    const [x, y, z] = vector;
    const sinPhi = Math.sin(view.phi);
    const cosPhi = Math.cos(view.phi);
    const sinTheta = Math.sin(view.theta);
    const cosTheta = Math.cos(view.theta);
    const scale = RADIUS + ELEVATION;
    return {
      u: ((cosPhi * x + sinPhi * z) * scale + 1) / 2,
      v: (-(sinPhi * sinTheta * x + cosTheta * y - cosPhi * sinTheta * z) * scale + 1) / 2,
      depth: -sinPhi * cosTheta * x + sinTheta * y + cosPhi * cosTheta * z,
    };
  };

  const shortestTurn = (from: number, to: number) => {
    const turn = (to - from) % (Math.PI * 2);
    return turn > Math.PI ? turn - Math.PI * 2 : turn < -Math.PI ? turn + Math.PI * 2 : turn;
  };

  if (canvas && stage) {
    const markerData = JSON.parse(canvas.dataset.markers ?? "[]") as MarkerData[];
    const home = viewFor(JSON.parse(canvas.dataset.home ?? "[0,0]") as LatLng);
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
    const dpr = Math.min(window.devicePixelRatio || 1, 2);
    const markerVectors = markerData.map((marker) => toVector(marker.location));

    const pins = [...stage.querySelectorAll<HTMLElement>(".polaroid")].map((element) => ({
      element,
      code: element.dataset.code ?? "",
      vector: toVector(JSON.parse(element.dataset.coords ?? "[0,0]") as LatLng),
      shown: false,
      restUntil: 0,
      x: 0,
      y: 0,
    }));
    type Pin = (typeof pins)[number];

    let focused: string | null = null;
    let hovering = false;
    let nextRotate = performance.now() + PIN_ROTATE_INTERVAL;

    let palette = readPalette();
    let view: View = { ...home };
    let target: View | null = null;
    let sway = 0;
    let pulse = 0;
    let dragStart: { x: number; y: number; view: View } | null = null;
    let visible = true;
    let size = canvas.offsetWidth;

    const buildMarkers = () =>
      markerData
        .map((marker, index) => ({ marker, depth: project(markerVectors[index]!, view).depth }))
        .filter(({ depth }) => depth > 0.12)
        .map(({ marker }) => ({
          location: marker.location,
          size: marker.current ? 0.045 + Math.sin(pulse) * 0.012 : 0.03,
          color: marker.current ? palette.currentColor : palette.markerColor,
        }));

    const globe = createGlobe(canvas, {
      devicePixelRatio: dpr,
      width: size,
      height: size,
      phi: view.phi,
      theta: view.theta,
      dark: palette.dark,
      diffuse: 1.2,
      mapSamples: 20000,
      mapBrightness: palette.mapBrightness,
      baseColor: palette.baseColor,
      markerColor: palette.markerColor,
      glowColor: palette.glowColor,
      markers: buildMarkers(),
      markerElevation: ELEVATION,
    });

    const overlaps = (a: Pin, b: Pin, width: number, height: number) =>
      Math.abs(a.x - b.x) < width * 0.74 && Math.abs(a.y - b.y) < height * 0.74;

    const restCrowdedPin = (now: number, candidates: Pin[], width: number, height: number) => {
      if (now < nextRotate || hovering) return;
      nextRotate = now + PIN_ROTATE_INTERVAL;
      const crowded = candidates.filter(
        (pin) =>
          pin.shown &&
          pin.code !== focused &&
          candidates.some((other) => !other.shown && overlaps(pin, other, width, height)),
      );
      const resting = crowded[Math.floor(Math.random() * crowded.length)];
      if (resting) resting.restUntil = now + PIN_REST;
    };

    const placePins = (now: number) => {
      const first = pins[0];
      if (!first) return;
      const stageBox = stage.getBoundingClientRect();
      const canvasBox = canvas.getBoundingClientRect();
      const width = first.element.offsetWidth;
      const height = first.element.offsetHeight;
      const candidates = pins.filter((pin) => {
        const point = project(pin.vector, view);
        pin.x = canvasBox.left - stageBox.left + point.u * canvasBox.width;
        pin.y = canvasBox.top - stageBox.top + point.v * canvasBox.height;
        return (
          point.depth > 0.3 &&
          pin.y > height * 0.7 &&
          pin.y < stageBox.height * PIN_FLOOR &&
          pin.x > width / 2 &&
          pin.x < stageBox.width - width / 2
        );
      });
      restCrowdedPin(now, candidates, width, height);
      const rank = (pin: Pin) =>
        pin.code === focused ? 0 : pin.restUntil > now ? 3 : pin.shown ? 1 : 2;
      const placed: Pin[] = [];
      for (const pin of [...candidates].sort((a, b) => rank(a) - rank(b))) {
        if (placed.every((other) => !overlaps(pin, other, width, height))) placed.push(pin);
      }
      for (const pin of pins) {
        pin.shown = placed.includes(pin);
        pin.element.style.transform = `translate(${pin.x}px, ${pin.y}px)`;
        pin.element.classList.toggle("is-shown", pin.shown);
        pin.element.classList.toggle("is-focus", pin.shown && pin.code === focused);
        pin.element.tabIndex = pin.shown ? 0 : -1;
      }
    };

    const viewer = document.querySelector<HTMLDialogElement>(".photo-viewer");
    const viewerPreview = viewer?.querySelector<HTMLImageElement>(".photo-preview");
    const viewerFull = viewer?.querySelector<HTMLImageElement>(".photo-full");
    const viewerCaption = viewer?.querySelector("figcaption");

    const openPhoto = (pin: Pin) => {
      if (!viewer || !viewerPreview || !viewerFull || !viewerCaption) return;
      const full = pin.element.dataset.full ?? "";
      viewerPreview.src = pin.element.querySelector("img")?.src ?? "";
      viewerCaption.textContent = pin.element.dataset.caption ?? "";
      viewerFull.classList.remove("is-loaded");
      viewerFull.onload = () => viewerFull.classList.add("is-loaded");
      viewerFull.src = full;
      viewerFull.alt = `Photo from ${pin.element.dataset.caption ?? ""}`;
      viewer.showModal();
    };

    viewer?.addEventListener("click", (event) => {
      const target = event.target;
      if (target === viewer || (target instanceof HTMLElement && target.closest(".photo-close"))) {
        viewer.close();
      }
    });

    for (const pin of pins) {
      pin.element.addEventListener("click", () => openPhoto(pin));
    }

    const step = () => {
      if (dragStart || reduceMotion) return;
      if (hovering && !target) return;
      if (target) {
        const phiTurn = shortestTurn(view.phi, target.phi);
        const thetaTurn = target.theta - view.theta;
        view.phi += phiTurn * 0.08;
        view.theta += thetaTurn * 0.08;
        if (Math.abs(phiTurn) < 0.002 && Math.abs(thetaTurn) < 0.002) target = null;
        return;
      }
      sway += 0.005;
      view.phi += Math.cos(sway) * SWAY_SPEED;
    };

    const tick = () => {
      if (visible) {
        step();
        pulse += 0.06;
        globe.update({ phi: view.phi, theta: view.theta, markers: buildMarkers() });
        placePins(performance.now());
      }
      requestAnimationFrame(tick);
    };

    canvas.addEventListener("pointerdown", (event) => {
      dragStart = { x: event.clientX, y: event.clientY, view: { ...view } };
      target = null;
      canvas.setPointerCapture(event.pointerId);
      canvas.classList.add("is-dragging");
    });

    canvas.addEventListener("pointermove", (event) => {
      if (!dragStart) return;
      view.phi = dragStart.view.phi + (event.clientX - dragStart.x) / 160;
      view.theta = Math.max(
        -0.9,
        Math.min(0.9, dragStart.view.theta + (event.clientY - dragStart.y) / 220),
      );
    });

    stage.addEventListener("pointerenter", (event) => {
      hovering = event.pointerType === "mouse";
    });
    stage.addEventListener("pointerleave", () => {
      hovering = false;
    });

    const endDrag = () => {
      dragStart = null;
      sway = 0;
      canvas.classList.remove("is-dragging");
    };
    canvas.addEventListener("pointerup", endDrag);
    canvas.addEventListener("pointercancel", endDrag);

    const focusFlag = (event: Event) => {
      const flag = event.currentTarget;
      if (!(flag instanceof HTMLElement)) return;
      target = viewFor(JSON.parse(flag.dataset.coords ?? "[0,0]") as LatLng);
      focused = flag.dataset.code ?? null;
      if (reduceMotion) {
        view = { ...target };
        target = null;
      }
    };

    const returnHome = () => {
      target = { ...home };
      sway = 0;
      focused = null;
      if (reduceMotion) {
        view = { ...home };
        target = null;
      }
    };

    for (const flag of document.querySelectorAll<HTMLElement>(".travel-flag")) {
      flag.addEventListener("pointerenter", focusFlag);
      flag.addEventListener("focus", focusFlag);
      flag.addEventListener("click", (event) => {
        focusFlag(event);
        const pin = pins.find((candidate) => candidate.code === flag.dataset.code);
        if (pin) openPhoto(pin);
      });
      flag.addEventListener("pointerleave", returnHome);
      flag.addEventListener("blur", returnHome);
    }

    new ResizeObserver(() => {
      size = canvas.offsetWidth;
      globe.update({ width: size, height: size });
    }).observe(canvas);

    new IntersectionObserver(([entry]) => {
      visible = entry?.isIntersecting ?? true;
    }).observe(stage);

    new MutationObserver(() => {
      palette = readPalette();
      globe.update({
        dark: palette.dark,
        mapBrightness: palette.mapBrightness,
        baseColor: palette.baseColor,
        glowColor: palette.glowColor,
        markerColor: palette.markerColor,
      });
    }).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });

    requestAnimationFrame(() => canvas.classList.add("is-ready"));
    tick();
  }
</script>
